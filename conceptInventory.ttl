@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix am:      <https://purl.org/archimate#> .
@prefix jw:      <https://w3id.org/archimate#> .
@prefix km3:     <https://meta.linked.archi/archimate3/> .
@prefix km4:     <https://meta.linked.archi/archimate4/> .

# Non-resolving URN for now, until the group agrees on a permanent,
# community-owned namespace (see discussion #8, Decision 5).
@prefix spec:    <urn:archimate:spec:> .

# ---------------------------------------------------------------------------
# Scope of this file
#
# This is a list of shared concept identifiers, NOT an ontology. Each entry is
# a skos:Concept with a label, the specification version(s) it belongs to, and
# mappings to the participating ontologies. Keep it that way:
#   - no rdfs:subClassOf / skos:broader hierarchy
#   - no rdfs:domain / rdfs:range
#   - no choice of how relationships are represented in RDF
# Anything beyond identity and mappings belongs in the individual ontologies.
#
# Initial ArchiMate 3.2 entries were taken from archimate_ontology at commit
# 083cf53 (2026-11-04). Labels only: no specification text is copied here.
# 4.0 scheme membership is still to be added by the 4.0 implementers.
#
# Versions: a concept is in the 3.2 scheme, the 4.0 scheme, or both. When a
# concept's meaning changes between versions (e.g. 3.2 BusinessProcess vs the
# layer-generic 4.0 Process), it gets a separate concept rather than being
# shared across both schemes.
#
# Mapping properties (SKOS mappings, never OWL equivalence):
#   skos:exactMatch   same concept
#   skos:closeMatch   same concept, representation differs (see notes)
#   skos:broadMatch / skos:narrowMatch   more general / more specific
# A concept with no mapping to an ontology is a gap until resolved (#6).
#
# Version coverage of the participating ontologies:
#   am:   archimate_ontology  - 3.2
#   jw:   archimate-rdf       - 4.0 core + 3.2 compatibility profile
#   km3:  Linked.Archi        - 3.1/3.2
#   km4:  Linked.Archi        - 4.0
# ---------------------------------------------------------------------------

spec:ArchiMate32 a skos:ConceptScheme ;
    skos:prefLabel "ArchiMate 3.2 concepts"@en ;
    dcterms:source "ArchiMate 3.2 Specification, The Open Group" .

spec:ArchiMate40 a skos:ConceptScheme ;
    skos:prefLabel "ArchiMate 4.0 concepts"@en ;
    dcterms:source "ArchiMate 4.0 Specification, The Open Group" .



## General Concepts
# Scheme membership of these general concepts in 4.0 still needs to be checked
# against the 4.0 specification text.

spec:Model a skos:Concept ;
    skos:prefLabel "Model"@en ;
    skos:inScheme spec:ArchiMate32 , spec:ArchiMate40 ;
    skos:exactMatch am:Model .

spec:Concept a skos:Concept ;
    skos:prefLabel "Concept"@en ;
    skos:inScheme spec:ArchiMate32 , spec:ArchiMate40 ;
    skos:exactMatch am:Concept , jw:Concept , km3:Concept , km4:Concept .

spec:Element a skos:Concept ;
    skos:prefLabel "Element"@en ;
    skos:inScheme spec:ArchiMate32 , spec:ArchiMate40 ;
    skos:exactMatch am:Element , jw:Element , km3:Element , km4:Element .

spec:Identifier a skos:Concept ;
    skos:prefLabel "Identifier"@en ;
    skos:inScheme spec:ArchiMate32 , spec:ArchiMate40 ;
    skos:closeMatch am:identifier ;
    skos:editorialNote "am: and jw: model the identifier as a datatype property, not a class."@en .

spec:Relationship a skos:Concept ;
    skos:prefLabel "Relationship"@en ;
    skos:inScheme spec:ArchiMate32 , spec:ArchiMate40 ;
    skos:closeMatch am:Relationship , jw:Relationship ;
    skos:editorialNote "Relationship representation diverges between the ontologies (direct predicates / RDF-star vs relationships as resources); see the conformance tests (#7)."@en .

spec:RelationshipConnector a skos:Concept ;
    skos:prefLabel "Relationship Connector"@en ;
    skos:inScheme spec:ArchiMate32 ;
    skos:exactMatch am:RelationshipConnector .

spec:Layer a skos:Concept ;
    skos:prefLabel "Layer"@en ;
    skos:inScheme spec:ArchiMate32 , spec:ArchiMate40 ;
    skos:closeMatch am:Layer ;
    skos:editorialNote "am: models a layer as a class of elements (e.g. BusinessProcess is a subclass of BusinessLayer); jw: models layers as individuals of jw:Layer. See #6."@en .

spec:Aspect a skos:Concept ;
    skos:prefLabel "Aspect"@en ;
    skos:inScheme spec:ArchiMate32 , spec:ArchiMate40 ;
    skos:closeMatch am:Aspect ;
    skos:editorialNote "am: uses aspects as element categories (superclasses of element types)."@en .

spec:CompositeElement a skos:Concept ;
    skos:prefLabel "Composite Element"@en ;
    skos:inScheme spec:ArchiMate32 ;
    skos:exactMatch am:CompositeElement .

spec:View a skos:Concept ;
    skos:prefLabel "View"@en ;
    skos:inScheme spec:ArchiMate32 ;
    skos:exactMatch am:ArchiMateView .

spec:Viewpoint a skos:Concept ;
    skos:prefLabel "Viewpoint"@en ;
    skos:inScheme spec:ArchiMate32 ;
    skos:exactMatch am:ArchiMateViewpoint .

spec:Property a skos:Concept ;
    skos:prefLabel "Property"@en ;
    skos:inScheme spec:ArchiMate32 ;
    skos:exactMatch am:Property .


## Generic Element Categories
# The generic metamodel's element categories. In am: these are superclasses of
# the element types; other ontologies may not declare them at all.

spec:ActiveStructureElement a skos:Concept ;
    skos:prefLabel "Active Structure Element"@en ;
    skos:inScheme spec:ArchiMate32 ;
    skos:exactMatch am:ActiveStructure .

spec:InternalActiveStructureElement a skos:Concept ;
    skos:prefLabel "Internal Active Structure Element"@en ;
    skos:inScheme spec:ArchiMate32 ;
    skos:exactMatch am:InternalActiveStructure .

spec:ExternalActiveStructureElement a skos:Concept ;
    skos:prefLabel "External Active Structure Element"@en ;
    skos:inScheme spec:ArchiMate32 ;
    skos:exactMatch am:ExternalActiveStructure .

spec:BehaviorElement a skos:Concept ;
    skos:prefLabel "Behavior Element"@en ;
    skos:inScheme spec:ArchiMate32 ;
    skos:closeMatch am:BehaviorAspect ;
    skos:editorialNote "am: declares this as an aspect."@en .

spec:InternalBehaviorElement a skos:Concept ;
    skos:prefLabel "Internal Behavior Element"@en ;
    skos:inScheme spec:ArchiMate32 ;
    skos:exactMatch am:InternalBehavior .

spec:ExternalBehaviorElement a skos:Concept ;
    skos:prefLabel "External Behavior Element"@en ;
    skos:inScheme spec:ArchiMate32 ;
    skos:exactMatch am:ExternalBehavior .

spec:CollectiveBehaviorElement a skos:Concept ;
    skos:prefLabel "Collective Behavior Element"@en ;
    skos:inScheme spec:ArchiMate32 ;
    skos:exactMatch am:CollectiveBehavior .

spec:PassiveStructureElement a skos:Concept ;
    skos:prefLabel "Passive Structure Element"@en ;
    skos:inScheme spec:ArchiMate32 ;
    skos:exactMatch am:PassiveStructure .

spec:MotivationElement a skos:Concept ;
    skos:prefLabel "Motivation Element"@en ;
    skos:inScheme spec:ArchiMate32 ;
    skos:closeMatch am:MotivationAspect ;
    skos:editorialNote "am: declares this as an aspect."@en .


## Layers
