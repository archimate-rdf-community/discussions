# ---------------------------------------------------------------------------
# archimate_ontology classes intentionally NOT listed as spec concepts, because
# they structure that ontology rather than name an ArchiMate concept:
#   am:ArchiMate, am:Domain, am:CoreDomain, am:StrategyDomain,
#   am:MotivationDomain, am:ImplementationAndMigrationDomain,
#   am:StructureAspect, am:GenericComposite, am:LayerComposite,
#   am:CoreLayer, am:ExtendedLayer, am:Attribute
# ---------------------------------------------------------------------------
